PORT=8080
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173
BACKEND_API_KEY=
STOCK_DATA_API_KEY=

# Python simulation-agent (intraday OHLC paths)
SIMULATION_AGENT_URL=http://localhost:8090
SIMULATION_AGENT_API_KEY=

# Path to shared DATA/ (stock_metadata.csv + OHLC CSVs). Empty = ../DATA from backend-app.
DATA_DIR=

# Cleartext local DB (users/portfolios/global sim). Empty = ./local-db
LOCAL_DB_DIR=

ADMIN_USERNAME=rootadmin
ADMIN_PASSWORD=admin123

# Firebase stubs (replace with real credentials later)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR=true
FIREBASE_DB_URL=

# Simulation pacing: wall-clock day = 1875s / SIMULATION_TIME_SCALE
# 1 = production timing (31m 15s per day). Higher = faster local runs.
SIMULATION_TIME_SCALE=1
LONG_POLL_MAX_MS=25000
